# 本地测试配置示例；密码只适用于本机测试，不得提交生产密钥。
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/nexushub?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: ${NEXUSHUB_DB_PASSWORD}
    driver-class-name: com.mysql.cj.jdbc.Driver

nexushub:
  security:
    # 测试管理员凭据由本地种子或环境变量提供，正式环境必须重新生成。
    seed-admin-username: admin
    seed-admin-password: ${NEXUSHUB_SEED_ADMIN_PASSWORD}
    session-secret: ${NEXUSHUB_SESSION_SECRET}
  solver:
    # 初版不在页面展示性能指标；这些限制只用于保护本地任务执行。
    interactive-time-limit-ms: 2000
    analysis-time-limit-ms: 30000
    max-queue-size: 100
    per-user-concurrency: 2
